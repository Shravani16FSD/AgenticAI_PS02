# Environment Variables Example for Chapter AI Career Coach
# Copy this file to .env or .env.local for local overrides.
# Never commit secrets or private keys to source control.

# Optional custom backend endpoint for AI agent streaming
# Default: /api/chat (proxied by Vite to http://localhost:8000)
VITE_AI_API_ENDPOINT=

# NOTE: The Google Gemini API key must NEVER be placed in frontend environment files.
# Store GEMINI_API_KEY strictly in backend/.env on the server.
