# Environment Variables Example for NEXORA AI Career Coach Frontend
# Copy this file to .env or configure in Vercel project settings.
# Never commit secrets or private keys to source control.

# Backend API Base URL for production
# Set this to your deployed backend URL (e.g., https://nexora-career-coach-api.onrender.com)
VITE_API_BASE_URL=

# Optional custom backend endpoint override for AI agent streaming
# Default: ${VITE_API_BASE_URL}/api/chat (or /api/chat locally via Vite proxy)
VITE_AI_API_ENDPOINT=

# NOTE: The Google Gemini API key and GitHub tokens must NEVER be placed in frontend environment files.
# Store GEMINI_API_KEY and GITHUB_TOKEN strictly in backend environment variables.
