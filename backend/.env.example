# Environment Configuration for Chapter AI Career Coach Backend
# Copy to .env for local development

# Database URL: Defaults to local SQLite file.
# For production PostgreSQL, use: postgresql+psycopg2://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./career_coach.db

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Google Gemini API Configuration (Backend-only)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Keep this file secret and never commit .env to Git or expose keys to the client.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite


